VITE_API_BASE_URL=http://localhost:8000

# The Google OAuth client id (Web application). Leave it out and the
# "Continue with Google" button does not render.
VITE_GOOGLE_CLIENT_ID=

# WorkOS, for the Google redirect. Both are needed together — either one
# missing and the Google block does not render, because vite inlines these at
# build time and `present()` in lib/workosAuth.ts reads undefined.
# VITE_WORKOS_CLIENT_ID must be the same client id the API has as
# WORKOS_CLIENT_ID; the redirect URI must be registered in the WorkOS
# dashboard exactly as written here.
VITE_WORKOS_CLIENT_ID=
VITE_WORKOS_REDIRECT_URI=http://localhost:5173/auth/callback
