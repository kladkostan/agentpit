# FastAPI server
AGENTPIT_DB_PATH=agentpit.db
SYNC=true
LIQUIDITY_ENGINE=true

# Auth — pick a long random string for local dev; rotate per deployment in prod.
JWT_SECRET=<generate with: python -c "import secrets; print(secrets.token_urlsafe(48))">

# Local fork + deploy config. Copy to .env.local and fill in.
# .env.local is gitignored — never commit real keys here.

# === Polygon fork (used by scripts/run_node.sh) ===
POLYGON_RPC=https://rpc-mainnet.matic.quiknode.pro
# Optional: pin the fork to a specific block for deterministic re-runs.
# FORK_BLOCK=

# === Deploy config (used by scripts/deploy_exchange.sh) ===
# Anvil prefunded account #0 — well-known dev key. SAFE FOR LOCAL ONLY.
PK=<private-key>
ADMIN=<admin-address>
RPC_URL=http://127.0.0.1:8545

# === Polygon mainnet addresses inherited from the fork ===
# (collateral is now our own AgentpitUSD, deployed by deploy_exchange.sh)
CTF=0x4D97DCd97eC945f40cF65F87097ACe5EA0476045
PROXY_FACTORY=0xaB45c5A4B0c941a2F231C04C3f49182e1A254052
SAFE_FACTORY=0xaacFeEa03eb1561C4e67d661e40682Bd20E3541b

# Optional override for the per-signup grant (default 1,000,000 apUSD).
# SIGNUP_GRANT_RAW=1000000000000
